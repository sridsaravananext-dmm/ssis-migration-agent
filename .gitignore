# ============================================================
# .gitignore
# ============================================================

gitignore = """
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
venv/
.env
.DS_Store

*.egg-info/
dist/
build/

.idea/
.vscode/

# Generated migration artifacts
generated_output/

# Local temporary files
tmp/
temp/

# Databricks / local execution artifacts
*.log
"""


path = REPO_ROOT / ".gitignore"

path.write_text(
    gitignore.strip() + "\n",
    encoding="utf-8"
)

print(f"✓ Created {path}")