{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssis-migration:schema:csharp_syntax:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "syntax_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "PARSED",
        "INVALID",
        "LIMIT_EXCEEDED"
      ]
    },
    "semantic_status": {
      "const": "NOT_VERIFIED"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "tree-sitter-c-sharp"
        },
        "version": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "runtime_version"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "offset_unit": {
      "const": "UTF8_BYTES"
    },
    "evidence": {
      "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/evidence"
    },
    "construct_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 0
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "start_byte",
          "end_byte",
          "line",
          "message"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "syntax_version",
    "status",
    "semantic_status",
    "parser",
    "source_sha256",
    "size_bytes",
    "offset_unit",
    "evidence",
    "construct_counts",
    "diagnostics",
    "limitations"
  ]
}
