{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssis-migration:schema:migration_contract:1.0",
  "title": "Legacy-intent migration contract bridge, version 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "source_platform",
    "target_platform",
    "source_behavior",
    "required_behavior",
    "target_capabilities",
    "target_design",
    "assumptions",
    "unresolved_items",
    "semantic_risks",
    "validation_requirements",
    "status",
    "contract_version",
    "contract_id",
    "binding_digest",
    "inputs",
    "outputs",
    "dependencies",
    "implementation_strategy",
    "evidence_files",
    "provenance"
  ],
  "properties": {
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "source_platform": {
      "enum": [
        "ssis",
        "tm1",
        "informatica",
        "bods",
        "odi",
        "unknown"
      ]
    },
    "target_platform": {
      "const": "databricks"
    },
    "source_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_intent",
        "legacy_step",
        "supporting_definitions",
        "analysis_status",
        "diagnostics"
      ],
      "properties": {
        "migration_intent": {
          "type": "object"
        },
        "legacy_step": {
          "type": "object"
        },
        "supporting_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "analysis_status": {
          "const": "UNVERIFIED_LEGACY_ANALYSIS"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/diagnostic"
          }
        }
      }
    },
    "required_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligations",
        "criticality_status",
        "coverage_status"
      ],
      "properties": {
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "behavior_id",
              "kind",
              "source_value",
              "evidence",
              "verification",
              "critical",
              "weight"
            ],
            "properties": {
              "behavior_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "control_flow",
                  "data_flow",
                  "transformation",
                  "source_procedure",
                  "destination_procedure",
                  "normalized_node",
                  "normalized_edge"
                ]
              },
              "source_value": {},
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/evidence"
                }
              },
              "verification": {
                "const": "NOT_VERIFIED"
              },
              "critical": {
                "type": "null"
              },
              "weight": {
                "type": "null"
              }
            }
          }
        },
        "criticality_status": {
          "const": "UNASSESSED"
        },
        "coverage_status": {
          "const": "NOT_VERIFIED"
        }
      }
    },
    "target_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_languages",
        "execution_status",
        "semantic_equivalence"
      ],
      "properties": {
        "generation_languages": {
          "type": "array",
          "items": {
            "enum": [
              "spark_sql",
              "pyspark"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "execution_status": {
          "const": "NOT_RUN"
        },
        "semantic_equivalence": {
          "const": "NOT_VERIFIED"
        }
      }
    },
    "target_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "deployment"
      ],
      "properties": {
        "execution_mode": {
          "enum": [
            "GENERATE_ONLY",
            "REVIEW_ONLY"
          ]
        },
        "deployment": {
          "const": "DISABLED"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "source_behavior",
          "target_behavior",
          "severity",
          "mitigation"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "source_behavior": {
            "type": "string"
          },
          "target_behavior": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "mitigation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "validation_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW_REQUIRED",
        "BLOCKED"
      ]
    },
    "contract_version": {
      "const": "1.0"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^contract-[0-9a-f]{24}$"
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "schema_status",
          "evidence"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "schema_status": {
            "const": "UNVERIFIED"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/evidence"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "schema_status",
          "evidence"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "schema_status": {
            "const": "UNVERIFIED"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/evidence"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference",
          "status",
          "evidence"
        ],
        "properties": {
          "source_role": {
            "enum": [
              "source",
              "destination"
            ]
          },
          "kind": {
            "enum": [
              "step",
              "procedure",
              "file"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "DECLARED",
              "SUPPLIED",
              "MISSING",
              "RESOLVED",
              "AMBIGUOUS",
              "CONFLICTING"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/evidence"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "procedure"
                }
              }
            },
            "then": {
              "required": [
                "source_role"
              ]
            }
          }
        ]
      }
    },
    "implementation_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "legacy_details",
        "verification"
      ],
      "properties": {
        "decision": {
          "enum": [
            "DETERMINISTIC",
            "AI_ASSISTED",
            "REVIEW_REQUIRED",
            "UNSUPPORTED"
          ]
        },
        "legacy_details": {
          "type": "object"
        },
        "verification": {
          "const": "UNVERIFIED_LEGACY_DECISION"
        }
      }
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/file"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder",
        "version",
        "evidence",
        "limitation"
      ],
      "properties": {
        "builder": {
          "const": "migration_intent_bridge"
        },
        "version": {
          "const": "1.0"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:ssis-migration:schema:common:1.0#/$defs/evidence"
          }
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_design": {
            "properties": {
              "execution_mode": {
                "const": "REVIEW_ONLY"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "target_capabilities": {
            "properties": {
              "generation_languages": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target_capabilities": {
            "properties": {
              "generation_languages": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
