{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssis-migration:schema:data_observation:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["observation_version", "observation_id", "side", "source_platform", "case_id", "unit_id", "binding", "comparison_mode", "columns", "rows", "provenance"],
  "properties": {
    "observation_version": {"const": "1.0"},
    "observation_id": {"type": "string", "minLength": 1},
    "side": {"enum": ["SOURCE", "TARGET"]},
    "source_platform": {"enum": ["ssis", "tm1", "informatica", "bods", "odi"]},
    "case_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_contract_id", "source_sha256", "artifact_hashes", "input_snapshot_sha256", "parameters_sha256"],
      "properties": {
        "generation_contract_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "input_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "parameters_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "comparison_mode": {"enum": ["MULTISET", "ORDERED"]},
    "columns": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "type", "nullable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["INT64", "DECIMAL", "STRING", "BOOLEAN", "DATE", "TIMESTAMP_UTC"]},
          "nullable": {"type": "boolean"}
        }
      }
    },
    "rows": {
      "type": "array", "maxItems": 10000,
      "items": {"type": "array", "maxItems": 256, "items": {"type": ["string", "integer", "boolean", "null"]}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "engine", "engine_version", "capture_method", "captured_at", "snapshot_id"],
      "properties": {
        "kind": {"enum": ["SOURCE_ENGINE", "TARGET_ENGINE", "SYNTHETIC"]},
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "capture_method": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
