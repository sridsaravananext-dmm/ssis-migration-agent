{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssis-migration:schema:acceptance_evidence:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "artifact_hashes",
    "policy_digest",
    "checks",
    "gates"
  ],
  "properties": {
    "evidence_version": {
      "const": "1.0"
    },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "behavior_id",
          "dimension",
          "status",
          "reports"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "behavior_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dimension": {
            "enum": [
              "semantic",
              "execution",
              "data_equivalence"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "UNSUPPORTED",
              "UNVERIFIED"
            ]
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "locator",
                "reviewer",
                "method"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "status",
          "reports"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "UNSUPPORTED",
              "UNVERIFIED"
            ]
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "locator",
                "reviewer",
                "method"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
