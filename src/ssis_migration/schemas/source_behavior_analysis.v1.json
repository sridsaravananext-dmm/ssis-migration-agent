{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssis-migration:schema:source_behavior_analysis:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_version", "profile", "ir_id", "source_analysis_sha256", "evidence_files", "requirements", "semantic_status", "scope"],
  "properties": {
    "analysis_version": {"const": "1.0"},
    "profile": {"type": "string", "minLength": 1},
    "ir_id": {"type": "string", "pattern": "^ir-[a-f0-9]{64}$"},
    "source_analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_files": {"type": "array", "minItems": 1, "items": {"$ref": "urn:ssis-migration:schema:common:1.0#/$defs/file"}},
    "requirements": {"type": "array", "maxItems": 10000, "items": {"$ref": "urn:ssis-migration:schema:source_requirement:1.0"}},
    "semantic_status": {"const": "NOT_VERIFIED"},
    "scope": {"const": "DECLARATIONS_AND_REVIEW_REQUIREMENTS"}
  }
}
